# Tønsberglivet Portal — Miljøvariabler
# Kopier denne filen til .env og fyll inn verdiene

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://bruker:passord@host:5432/tonsberglivet"

# Autentisering (Admin credentials & JWT/HMAC Session)
ADMIN_EMAIL="admin@dittdomene.no"
ADMIN_PASSWORD="sett-et-sterkt-passord-her"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generer-en-tilfeldig-streng-her"

# Google Gemini AI
GEMINI_API_KEY="din-google-ai-studio-api-nøkkel"

# 1min.ai (reservemotor for agenten hvis Gemini ikke svarer)
ONE_MIN_AI_API_KEY="din-1min-ai-nøkkel"

# Cloudinary (Bildebank)
CLOUDINARY_CLOUD_NAME="ditt-cloudinary-navn"
CLOUDINARY_API_KEY="din-cloudinary-api-nøkkel"
CLOUDINARY_API_SECRET="din-cloudinary-api-hemmelighet"

# Valgfritt: Vær-API
# Met.no krever ingen nøkkel, men en User-Agent header
WEATHER_USER_AGENT="tonsberglivet/1.0 hei@tonsberglivet.no"

# ─────────────────────────────────────────────────────────────────────────────
# AUTONOM AGENT (utgående) — adminpanelets «Autonom Agent» / AI Co-Pilot
# ─────────────────────────────────────────────────────────────────────────────

# Nøkkelen vi kaller agenten med (MCP-verktøyet «getBotResponse»).
#
# MÅ VÆRE SATT for at agenten skal svare i det hele tatt. Uten denne (og uten
# WEBHOOK_AGENT under) viser adminpanelet «Agent: Ikke konfigurert», og chatten
# svarer fra den lokale motoren i stedet – den henter da bare data fra vår egen
# database og sier ærlig at agenten ikke er tilkoblet.
#
# Det finnes ingen standardnøkkel i repoet lenger: den lå tidligere i
# src/app/api/bot-frame/route.ts, men repoet er offentlig, så den er fjernet og
# rotert. Hent gjeldende nøkkel fra agent-plattformen (Bot → API/MCP).
AGENT_API=""

# Samme nøkkel eksponert til nettleseren. Skal IKKE peke på backend-agenten.
# NEXT_PUBLIC_AGENT_API=""

# Valgfritt: overstyr MCP-endepunktet (standard: https://mcp.botsify.com/agent/mcp)
# AGENT_MCP_ENDPOINT=""
# AGENT_MCP_URL=""

# Valgfritt: webhook-transport. Prøves FØR MCP når den er satt.
# WEBHOOK_AGENT=""

# Tidsbudsjetter i millisekunder (standard: init 8000, kall 35000, webhook 15000)
# AGENT_MCP_INIT_TIMEOUT_MS=""
# AGENT_MCP_TIMEOUT_MS=""
# AGENT_WEBHOOK_TIMEOUT_MS=""

# Vert for den innebygde web-widgeten (standard: agentic.botsify.com)
# AGENTIC_HOST=""

# ─────────────────────────────────────────────────────────────────────────────
# INNKOMNE MCP-SERVER (/api/mcp) — agentens verktøy inn i Tønsberglivet
# ─────────────────────────────────────────────────────────────────────────────

# Delt hemmelighet som eksterne agenter bruker som «Authorization: Bearer …»
# eller «X-API-Key: …». Dette er tokenet agentens MCP-connector
# («tonsberglivet_backend») må sende.
#
# Er den ikke satt, avvises ALLE verktøykall med JSON-RPC -32001. Agenten får da
# ingen ekte data og svarer med en høflig unnskyldning i stedet.
#
# Bruk en NY, tilfeldig verdi her – aldri DEFAULT_BOT_KEY eller AGENT_API.
# Nøkkelen gir full skrivetilgang (publisere artikler, overskrive bedrifter,
# godkjenne torvleie og sende kontrakt på e-post).
MCP_API_KEY=""

# LES-ONLY nøkkel. Gir tilgang til de fire verktøyene som bare leser data:
#   hent_tonsberg_kontekst, hent_ventende_torvleier,
#   sok_steder_og_restauranter, sok_bedrifter_brreg
# Forsøk på skrivende verktøy avvises med JSON-RPC -32003, og tools/list viser
# bare leseverktøyene. Bruk denne på agenten når den ikke skal kunne endre noe.
#
# MERK: hent_ventende_torvleier returnerer personopplysninger (navn, e-post,
# telefon) på søkere. Behandle nøkkelen deretter.
MCP_READONLY_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# AGENT-WEBHOOK OG VARSLINGSKANALER
# ─────────────────────────────────────────────────────────────────────────────

# Autentiserer POST /api/agent/webhook (Slack slash-kommandoer m.m.)
# SLACK_SIGNING_SECRET=""
# AGENT_WEBHOOK_SECRET=""

# Varslingskanaler. Minst én må være satt for multiChannelReady.
# SLACK_WEBHOOK_URL=""
# AGENT_WEBHOOK_URL=""
# TEAMS_WEBHOOK_URL=""
# DISCORD_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# EKSTERNE DATAKILDER SOM AGENTENS VERKTØY BRUKER
# Mangler en nøkkel, svarer det tilhørende verktøyet tomt – ikke med en feil.
# ─────────────────────────────────────────────────────────────────────────────

# BRAVE_API_KEY=""
# TAVILY_API_KEY=""
# APIFY_API_KEY=""
# TICKETMASTER_API_KEY=""
# RESEND_API_KEY=""
# SMTP_URL=""
# DUETT_WEBHOOK_URL=""

# Cron (automatisk synk av arrangementer og bedrifter)
# CRON_SECRET=""
