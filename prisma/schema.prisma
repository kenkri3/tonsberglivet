generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════
// BRUKERE OG AUTENTISERING
// ═══════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(EDITOR)
  title         String?   // f.eks. "Daglig leder", "Kommunikasjonsansvarlig", "Redaktør", "Arrangementsansvarlig"
  phone         String?
  active        Boolean   @default(true)
  image         String?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles      Article[]
  sessions      Session[]
  accounts      Account[]
  activityLogs  ActivityLog[]
  assignedTasks TeamTask[]    @relation("AssignedTasks")
  createdTasks  TeamTask[]    @relation("CreatedTasks")
  internalNotes InternalNote[]
  sentInvitations Invitation[] @relation("SentInvitations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
}

/**
 * Invitasjon til en ny medarbeider.
 *
 * Passordet settes av den inviterte selv, på /invitasjon/<token>. Vi lagrer
 * aldri selve tokenen – bare et SHA-256-fingeravtrykk – slik at en leser av
 * databasen ikke kan bruke en utestående invitasjon til å ta over kontoen.
 */
model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String?
  title       String?
  role        Role      @default(EDITOR)
  tokenHash   String    @unique
  note        String?   @db.Text
  invitedById String?
  invitedBy   User?     @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedByName String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([expiresAt])
}

// ═══════════════════════════════
// INNHOLD — ARTIKLER
// ═══════════════════════════════

model Article {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?        @db.Text
  content     String         @db.Text
  published   Boolean        @default(false)
  featured    Boolean        @default(false)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category    ArticleCategory @default(BYLIVET)
  authorId    String?
  author      User?           @relation(fields: [authorId], references: [id])
  imageId     String?
  image       Image?          @relation(fields: [imageId], references: [id])

  @@index([category])
  @@index([published, publishedAt])
}

enum ArticleCategory {
  BYLIVET
  HVERDAGSLIVET
  NAERINGSLIVET
  REISELIVET
  STUDENTLIVET
}

// ═══════════════════════════════
// INNHOLD — ARRANGEMENTER
// ═══════════════════════════════

model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  location    String?
  address     String?
  startDate   DateTime
  endDate     DateTime?
  startTime   String?
  endTime     String?
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  externalUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    EventCategory @default(ARRANGEMENT)
  imageId     String?
  image       Image?        @relation(fields: [imageId], references: [id])

  @@index([startDate])
  @@index([published])
}

enum EventCategory {
  ARRANGEMENT
  KONSERT
  MARKED
  KURS
  BARN
  SPORT
  KULTUR
  FESTIVAL
}

// ═══════════════════════════════
// INNHOLD — BEDRIFTER
// ═══════════════════════════════

model Business {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  description  String?            @db.Text
  address      String?
  phone        String?
  email        String?
  website      String?
  openingHours String?            @db.Text
  published    Boolean            @default(false)
  featured     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  category     BusinessCategory   @default(ANNET)
  area         BusinessArea       @default(TONSBERG_SENTRUM)
  logoId       String?
  logo         Image?             @relation("BusinessLogo", fields: [logoId], references: [id])
  imageId      String?
  image        Image?             @relation("BusinessImage", fields: [imageId], references: [id])

  @@index([category])
  @@index([area])
  @@index([published])
}

enum BusinessCategory {
  SHOPPING
  MAT_DRIKKE
  AKTIVITET
  OVERNATTING
  FRISOR_VELVERE
  KULTUR
  BARN
  ANNET
}

enum BusinessArea {
  TONSBERG_SENTRUM
  TONSBERG_KOMMUNE
  FAERDER_KOMMUNE
}

// ═══════════════════════════════
// INNHOLD — PARTNERE
// ═══════════════════════════════

model Partner {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  website     String?
  description String?      @db.Text
  level       PartnerLevel @default(STANDARD)
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  logoId      String?
  logo        Image?       @relation(fields: [logoId], references: [id])

  @@index([level])
  @@index([published])
}

enum PartnerLevel {
  PREMIUM
  STANDARD
  BASIC
}

// ═══════════════════════════════
// INNHOLD — PROSJEKTER
// ═══════════════════════════════

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  content     String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  imageId     String?
  image       Image?        @relation(fields: [imageId], references: [id])

  @@index([status])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

// ═══════════════════════════════
// BILDEBANK (DAM)
// ═══════════════════════════════

model Image {
  id             String      @id @default(cuid())
  url            String
  publicId       String?     // Cloudinary public ID
  filename       String
  alt            String?
  width          Int?
  height         Int?
  format         String?
  sizeBytes      Int?

  // Manuell styring
  photographer   String?     // Fotograf-kreditering
  gdprStatus     GdprStatus  @default(PENDING)
  gdprNotes      String?     @db.Text

  // Tagging
  tags           String[]    // Array av tagger
  aiTags         String[]    // AI-genererte tagger
  location       String?     // F.eks. "Torvet", "Brygga"
  season         String?     // F.eks. "Sommer", "Jul"

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Mapper
  folderId       String?
  folder         ImageFolder? @relation(fields: [folderId], references: [id])

  // Relasjoner
  articles       Article[]
  events         Event[]
  businessLogos  Business[]  @relation("BusinessLogo")
  businessImages Business[]  @relation("BusinessImage")
  partners       Partner[]
  projects       Project[]

  @@index([tags])
  @@index([folderId])
}

model ImageFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    ImageFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  ImageFolder[] @relation("FolderHierarchy")
  images    Image[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([name, parentId])
}

enum GdprStatus {
  APPROVED
  PENDING
  REJECTED
}

// ═══════════════════════════════
// SKJEMAER OG FORESPØRSLER
// ═══════════════════════════════

model BookingRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  type        BookingType
  startDate   DateTime?
  endDate     DateTime?
  message     String?       @db.Text
  status      RequestStatus @default(NEW)
  zone        String?       // F.eks. "Torvet Sone A", "Kaldnes"
  powerNeeded Boolean       @default(false)
  waterNeeded Boolean       @default(false)
  totalPrice  Float?        // Total leiebeløp
  orgNr       String?       // Organisasjonsnummer
  confirmedAt DateTime?     // Tidspunkt for godkjenning/bekreftelse
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum BookingType {

  DAGPLASS
  SESONG
  HELAAR
}

enum RequestStatus {
  NEW
  PROCESSING
  APPROVED
  REJECTED
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PartnerApplication {
  id           String        @id @default(cuid())
  contactName  String
  businessName String
  email        String
  phone        String?
  message      String?       @db.Text
  status       RequestStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ═══════════════════════════════
// CMS — STATISKE SIDER
// ═══════════════════════════════

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════
// SYSTEMINNSTILLINGER & BYOK
// ═══════════════════════════════

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("GENERAL") // AI, NOTIFICATIONS, INTEGRATIONS
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// ═══════════════════════════════
// STILLINGER FRA NAV ARBEIDSPLASSEN
// ═══════════════════════════════

/**
 * Speil av aktive stillingsannonser for Tønsberg og Færder.
 *
 * NAVs stillingsfeed (pam-stilling-feed) er en endringsstrøm for hele landet,
 * ikke et søk. Vi henter derfor endringene, filtrerer på kommune her, og
 * lagrer resultatet lokalt. Vilkårene krever at en annonse fjernes fra vår
 * liste så snart den blir inaktiv hos NAV – derfor slettes raden ved INACTIVE.
 */
model JobVacancy {
  id                  String    @id // NAVs uuid for annonsen
  title               String
  employer            String
  municipality        String
  city                String?
  engagementType      String?
  extent              String?
  /** Rå verdi fra NAV. Kan være «Snarest» eller tom – ikke bruk som dato. */
  applicationDeadline String?
  published           DateTime?
  /** Alltid ISO-8601 med offset. Brukes til sortering og utløp. */
  expires             DateTime?
  link                String
  applicationUrl      String?
  isStudentFriendly   Boolean   @default(false)
  descriptionSnippet  String?   @db.Text
  sector              String?
  navStatus           String    @default("ACTIVE")
  navUpdatedAt        DateTime?
  lastSyncedAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([navStatus, municipality])
  @@index([expires])
  @@map("job_vacancies")
}


// ═══════════════════════════════
// TEAM SAMHANDLING & AKTIVITETSLOGG
// ═══════════════════════════════

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  userEmail  String?
  userRole   String?
  action     String   // f.eks. "ARTICLE_CREATED", "ARTICLE_PUBLISHED", "BOOKING_APPROVED", "USER_INVITED", "USER_UPDATED"
  details    String   // Menneskelig lesbar oppsummering
  targetType String?  // "Article", "BookingRequest", "User", "Event", "Partner", "Note", "Task"
  targetId   String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model TeamTask {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?        @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([assignedToId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model InternalNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  pinned    Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
